# Copy to .env (or set these on your host). Full launch guide: README.md

# ---- site ----
# Where the site is reachable. Use https:// in production (turns on secure cookies).
PUBLIC_URL=http://127.0.0.1:4317
PORT=4317
# Database + uploads. Point this at a persistent disk on your host, e.g. /data
DATA_DIR=data
# "production" turns off the demo account and enables asset caching.
NODE_ENV=development
# Override the demo account: 1 = always create it, 0 = never.
SEED_DEMO=
# Set to 1 when running behind a proxy/load balancer (Railway, Render, Caddy, nginx).
TRUST_PROXY=0

# ---- Discord (sign-in + live presence bot) ----
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# The server the bot lives in; linked users are added to it automatically.
DISCORD_GUILD_ID=
# Set to 1 to try the whole flow locally with simulated Discord accounts.
DISCORD_MOCK=0
